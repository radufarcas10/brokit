{
  "note": "The docs page (site/dist/docs.html, from README.md): links, layout, contents, and how it looks on a laptop and a phone, light and dark. Run with: npm run site:check",
  "url": "/docs.html",
  "ready": "document.readyState === 'complete'",
  "viewport": {
    "size": "1280x800",
    "reducedMotion": "reduce"
  },
  "steps": [
    {
      "expect": "(async () => {\n  const bad = [];\n  for (const a of document.querySelectorAll('a[href]')) {\n    const href = a.getAttribute('href');\n    const u = new URL(href, location.href);\n    if (u.origin !== location.origin) continue;\n    const id = decodeURIComponent(u.hash.slice(1));\n    if (u.pathname === location.pathname) {\n      if (id && !document.getElementById(id)) bad.push(href);\n      continue;\n    }\n    const res = await fetch(u.pathname);\n    if (!res.ok) bad.push(href + ' (HTTP ' + res.status + ')');\n    else if (id && !(await res.text()).includes('id=\"' + id + '\"')) bad.push(href + ' (no #' + id + ')');\n  }\n  return bad;\n})()",
      "equals": [],
      "timeout": 0,
      "note": "every link to this site answers, every #anchor exists"
    },
    {
      "expect": "document.documentElement.scrollWidth <= document.documentElement.clientWidth",
      "note": "nothing wider than the screen"
    },
    {
      "expect": "document.querySelectorAll('.toc a').length",
      "atLeast": 10,
      "note": "a contents list"
    },
    {
      "screenshot": "docs-top",
      "baseline": true
    },
    {
      "click": {
        "selector": ".toc a[href=\"#checks-and-baselines\"]"
      }
    },
    {
      "expect": "document.querySelector('.toc a.here')?.hash",
      "equals": "#checks-and-baselines",
      "note": "the contents mark the section jumped to"
    },
    {
      "expect": "Math.round(document.getElementById('checks-and-baselines').getBoundingClientRect().top)",
      "near": 80,
      "within": 2,
      "note": "the heading lands just below the bar"
    },
    {
      "screenshot": "docs-checks",
      "baseline": true
    },
    {
      "emulate": {
        "colorScheme": "dark"
      }
    },
    {
      "screenshot": "docs-checks-dark",
      "baseline": true
    },
    {
      "click": {
        "selector": ".theme-toggle"
      }
    },
    {
      "expect": "document.documentElement.dataset.theme",
      "equals": "light"
    },
    {
      "expect": "getComputedStyle(document.body).backgroundColor",
      "equals": "rgb(250, 250, 247)"
    },
    {
      "expect": "localStorage.getItem('brokit-theme')",
      "equals": "light"
    },
    {
      "click": {
        "selector": ".theme-toggle"
      }
    },
    {
      "expect": "document.documentElement.dataset.theme",
      "equals": "dark"
    },
    {
      "expect": "getComputedStyle(document.body).backgroundColor",
      "equals": "rgb(11, 12, 15)"
    },
    {
      "click": {
        "selector": ".theme-toggle"
      }
    },
    {
      "expect": "document.documentElement.dataset.theme ?? 'auto'",
      "equals": "auto"
    },
    {
      "expect": "localStorage.getItem('brokit-theme')",
      "equals": null,
      "note": "back to the system, nothing kept"
    },
    {
      "emulate": {
        "size": "390x844",
        "dpr": 1,
        "mobile": true,
        "colorScheme": "light"
      }
    },
    {
      "eval": "scrollTo(0, 0); 1"
    },
    {
      "expect": "document.documentElement.scrollWidth <= document.documentElement.clientWidth",
      "note": "nothing wider than the phone"
    },
    {
      "screenshot": "docs-phone-top",
      "baseline": true
    }
  ]
}
